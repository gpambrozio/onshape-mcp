{
  "name": "@gpambrozio/onshape-mcp",
  "version": "0.1.2",
  "mcpName": "io.github.gpambrozio/onshape",
  "description": "MCP server for Onshape CAD: 87 tools for documents, part studios, sketching, features, assemblies and export, with browser sign-in.",
  "license": "MIT",
  "author": "Gustavo Ambrozio",
  "homepage": "https://github.com/gpambrozio/onshape-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpambrozio/onshape-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/gpambrozio/onshape-mcp/issues"
  },
  "type": "module",
  "bin": {
    "onshape-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node scripts/run-tests.mjs",
    "bundle": "node scripts/build-mcpb.mjs",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run check && npm run build"
  },
  "keywords": [
    "onshape",
    "cad",
    "mcp",
    "modelcontextprotocol",
    "model-context-protocol",
    "3d-printing",
    "parametric",
    "claude"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "open": "^11.0.4",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
