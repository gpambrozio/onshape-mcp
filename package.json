{
  "name": "onshape-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Onshape CAD automation, with guided browser login (API key or OAuth 2.0).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "onshape-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test .build-test/test/*.test.js",
    "start": "node dist/index.js"
  },
  "keywords": [
    "onshape",
    "cad",
    "mcp",
    "model-context-protocol"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "open": "^11.0.4",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
